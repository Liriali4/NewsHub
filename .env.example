# NewsHub — Environment Configuration
# Copia este ficheiro para .env e preenche com os teus valores

# Segurança
SECRET_KEY=gera-uma-chave-longa-e-aleatória-aqui-pelo-menos-32-caracteres

# Ambiente
FLASK_ENV=development

# API de Notícias (escolher uma)
NEWS_API_KEY=a_tua_chave_da_newsapi_org_aqui
GNEWS_API_KEY=a_tua_chave_do_gnews_aqui

# Cache
NEWS_CACHE_TTL=300

# IA (opcional)
AI_ENABLED=false
OPENAI_API_KEY=sk-...
AI_MODEL=gpt-3.5-turbo
